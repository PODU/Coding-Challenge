{
  "name": "mdpresent",
  "version": "1.0.0",
  "description": "Markdown presentation tool — split a Markdown file into a themed slide deck, serve it with live reload, and export to PDF.",
  "type": "module",
  "bin": {
    "mdpresent": "./lib/cli.js"
  },
  "main": "./lib/index.js",
  "files": [
    "lib",
    "src/templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-templates.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node lib/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "MDP_E2E=1 vitest run test/e2e"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "puppeteer": "^23.0.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
