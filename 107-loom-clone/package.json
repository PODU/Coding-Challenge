{
  "name": "loom-clone",
  "version": "1.0.0",
  "description": "Coding Challenge #107 - Loom clone (browser screen/cam/mic recorder + chunked resumable upload + share-link streaming backend)",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "npm run build:server && npm run typecheck:web",
    "build:server": "tsc -p tsconfig.json",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "build:web": "vite build",
    "dev": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "start": "node dist/server/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vite": "^5.3.5",
    "vitest": "^2.0.5"
  }
}
