# --- Python package / fragile script ---
GITHUB_TOKEN=ghp_your_token_here
REVIEW_PROVIDER=anthropic          # anthropic | openai | ollama | mock
REVIEW_MODEL=claude-sonnet-5
REVIEW_API_KEY=sk-ant-your-key
# REVIEW_BASE_URL=                 # for openai-compatible endpoints / ollama
# REVIEW_GUIDELINES=               # override team guidelines
# REVIEW_MAX_WORKERS=4
# REVIEW_HTTP_TIMEOUT=60
# REVIEW_MODEL_TIMEOUT=120
# REVIEW_MAX_RETRIES=3
ANTHROPIC_API_KEY=sk-ant-your-key  # used by fragile/review.py

# --- Kestra OSS secrets (values must be base64-encoded!) ---
