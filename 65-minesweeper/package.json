{
  "name": "minesweeper",
  "version": "1.0.0",
  "description": "Coding Challenge #65 - Minesweeper: pure, headlessly-testable board engine + terminal UI (TypeScript/Node).",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "minesweeper": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "play": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
