# Spotify API credentials — copy to `.env` and fill in. NEVER commit real secrets.
# Obtain these from https://developer.spotify.com/dashboard

# Required for every flow.
SPOTIFY_CLIENT_ID=your-client-id-here
SPOTIFY_CLIENT_SECRET=your-client-secret-here

# Required only for the user (Authorization Code) flow — backing up private
# playlists and restoring. Must match a Redirect URI registered on the dashboard.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional. Where the refresh-token cache is stored (written with 0600 perms).
# Defaults to ~/.spotify_playlist_token.json
# SPOTIFY_TOKEN_CACHE=~/.spotify_playlist_token.json
