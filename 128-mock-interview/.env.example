# Anam (https://anam.ai) - enables live video interviews. Optional: without it
# the app runs in offline text-chat mode.
ANAM_API_KEY=

# Anthropic - enables real Claude STAR feedback. Optional: without it a
# deterministic heuristic mock is used.
ANTHROPIC_API_KEY=

# Optional overrides
# FEEDBACK_MODEL=claude-opus-4-8
# MAX_SESSION_SECONDS=170
# MOCKINTERVIEW_DATA_DIR=data
# ANAM_AVATAR_ID=
# ANAM_VOICE_ID=
# ANAM_ALT_VOICE_ID=
# ANAM_LLM_ID=
