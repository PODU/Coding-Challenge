# Copy to .env (which is git-ignored) and fill in. The app reads these from the
# host environment; nothing here is required to run the offline test suite.

# Anthropic API key -- the ONLY source of the key. Read only by AnthropicClient.
ANTHROPIC_API_KEY=

# Model id (brief-mandated default).
RTFM_MODEL=claude-opus-4-8

# Redis Stack connection (optional; only needed with --redis / use_redis=True).
REDIS_URL=redis://localhost:6379

# Retrieval / chunking tunables.
RTFM_TOP_K=5
RTFM_CHUNK_TOKENS=500
RTFM_CHUNK_OVERLAP=50
RTFM_EMBED_DIM=256

# Semantic cache cosine-similarity threshold for a hit.
RTFM_CACHE_THRESHOLD=0.95

# Session memory TTL in seconds (24h).
RTFM_SESSION_TTL=86400
