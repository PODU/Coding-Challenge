{
  "name": "epub-reader",
  "version": "1.0.0",
  "description": "Coding Challenge #109 - Ebook reader: a pure, headless EPUB parser plus reader logic and a browser reader UI.",
  "type": "module",
  "bin": {
    "epubreader": "dist/cli.js"
  },
  "main": "dist/parser/index.js",
  "scripts": {
    "fixtures": "tsx scripts/build-fixture.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run fixtures",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx src/cli.ts",
    "dev": "vite",
    "build:ui": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "dompurify": "^3.1.6",
    "fast-xml-parser": "^4.4.1",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^2.0.4"
  }
}
