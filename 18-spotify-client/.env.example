# Copy to .env and fill in your own values from the Spotify Developer Dashboard.
# https://developer.spotify.com/dashboard
#
# PKCE flow does NOT use a client secret, so none is ever stored here.

# Required: the Client ID of your registered Spotify application.
SPOTIFY_CLIENT_ID=your-client-id-here

# Optional: must exactly match a Redirect URI registered on the dashboard.
# Defaults to http://127.0.0.1:8888/callback when unset.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
