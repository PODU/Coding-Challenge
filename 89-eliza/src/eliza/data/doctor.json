{
  "initial": [
    "How do you do. Please tell me your problem.",
    "Hello. What seems to be troubling you?"
  ],
  "final": [
    "Goodbye. It was nice talking to you.",
    "Goodbye. This was a good session, take care."
  ],
  "quit": ["bye", "goodbye", "quit", "exit"],

  "memory_size": 5,

  "pre": {
    "dont": "don't",
    "cant": "can't",
    "wont": "won't",
    "recollect": "remember",
    "dreamed": "dreamt",
    "maybe": "perhaps",
    "computers": "computer",
    "machine": "computer",
    "machines": "computer"
  },

  "synonyms": {
    "family": ["mother", "father", "sister", "brother", "wife", "husband",
               "children", "child", "mom", "dad", "son", "daughter"],
    "belief": ["feel", "think", "believe", "wish"],
    "sad": ["unhappy", "depressed", "sick", "miserable", "sad"],
    "everyone": ["everybody", "nobody", "everyone", "noone", "anyone"]
  },

  "reflections": {
    "am": "are", "are": "am", "i": "you", "you": "i", "me": "you",
    "my": "your", "your": "my", "mine": "yours", "yours": "mine",
    "i'm": "you're", "you're": "i'm", "myself": "yourself",
    "yourself": "myself", "i'd": "you'd", "you'd": "i'd",
    "i've": "you've", "you've": "i've", "was": "were", "were": "was",
    "i'll": "you'll", "you'll": "i'll"
