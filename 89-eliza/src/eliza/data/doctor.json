      ],
      "rules": [
        { "decomp": "* my @family *",
          "reassemb": [
            "Tell me more about your family.",
            "Who else in your family (3)?",
            "Your (2)?"
          ] },
        { "decomp": "* my *",
          "reassemb": [
            "Your (2)?",
            "Why do you say your (2)?",
            "Does that suggest anything else which belongs to you?"
          ] }
      ]
    },
    {
      "keyword": "i",
      "rank": 1,
      "rules": [
        { "decomp": "* i @belief i *",
          "reassemb": [
            "Do you really think so?",
            "But you are not sure you (3).",
            "Do you doubt you (3)?"
          ] },
        { "decomp": "* i am @sad *",
          "reassemb": [
            "I am sorry to hear you are (2). Do you think coming here will help you not to be (2)?",
            "Do you think it's possible you became (2) for a reason?"
          ] },
        { "decomp": "* i am *",
          "reassemb": [
            "Is it because you are (2) that you came to me?",
            "How long have you been (2)?",
            "Do you believe it is normal to be (2)?"
          ] },
        { "decomp": "* i *",
          "reassemb": [
            "You say you (2)?",
            "Can you elaborate on that?",
            "Why do you (2)?"
          ] }
      ]
    },
    {
      "keyword": "you",
      "rank": 1,
      "rules": [
        { "decomp": "* you are *",
          "reassemb": [
            "What makes you think I am (2)?",
