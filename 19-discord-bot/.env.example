# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# Required: the bot token from the Discord Developer Portal (Bot -> Reset Token).
DISCORD_TOKEN=your-bot-token-here

# Required for registering slash commands: the application (client) id.
DISCORD_APP_ID=your-application-id-here

# Optional: register slash commands to a single guild for instant updates during
# development. Leave empty for global registration (used in production).
DISCORD_GUILD_ID=

# Optional: prefix for text commands (default: !).
COMMAND_PREFIX=!

# Optional: random-quote API endpoint (default: https://dummyjson.com/quotes/random).
QUOTES_API_URL=https://dummyjson.com/quotes/random

# Optional: path to the persisted challenge catalog (default: ./data/challenges.json).
CATALOG_PATH=./data/challenges.json

# Optional: log level - error | warn | info | debug (default: info).
LOG_LEVEL=info
