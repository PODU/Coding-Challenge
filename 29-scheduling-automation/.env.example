# CalDAV connection (basic auth via app password)
CALDAV_URL=https://caldav.example.com/
CALDAV_USERNAME=alice
CALDAV_APP_PASSWORD=app-specific-password-here

# OAuth 2.0 alternative (used if app password is not set).
# OAUTH_TOKEN_JSON is a JSON blob: {"access_token","refresh_token","token_uri","client_id","client_secret","expiry"}
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_TOKEN_JSON=

# Calendars to consolidate (Step 3). Comma-separated display names; empty = all.
CALENDARS=work,personal

# Organizer identity / timezone (all output is presented in this TZ).
ORGANIZER_TZ=Europe/London
ORGANIZER_EMAIL=alice@example.com
